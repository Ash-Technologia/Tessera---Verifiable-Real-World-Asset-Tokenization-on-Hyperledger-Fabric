# =============================================================================
# TESSERA Environment Configuration — Example
# Copy this file to .env and fill in values before starting the network.
# NEVER commit .env to version control.
# =============================================================================

# ============================================================
# FABRIC VERSION PINS
# ============================================================
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.17
COMPOSE_PROJECT_NAME=tessera

# ============================================================
# FABRIC CA BOOTSTRAP CREDENTIALS
# These are used only to bootstrap the Fabric CA containers.
# All actual identities are registered and enrolled via scripts.
# CHANGE THESE before any non-development deployment.
# ============================================================
CA_ORDERER_ADMIN_USER=admin
CA_ORDERER_ADMIN_PASS=adminpw
CA_ISSUER_ADMIN_USER=admin
CA_ISSUER_ADMIN_PASS=adminpw
CA_VERIFIER_ADMIN_USER=admin
CA_VERIFIER_ADMIN_PASS=adminpw
CA_COMPLIANCE_ADMIN_USER=admin
CA_COMPLIANCE_ADMIN_PASS=adminpw

# ============================================================
# COUCHDB CREDENTIALS
# These are the admin credentials for each peer's CouchDB instance.
# CHANGE THESE before any non-development deployment.
# ============================================================
COUCHDB_USER=admin
COUCHDB_PASSWORD=adminpw

# ============================================================
# NODE.JS BACKEND
# ============================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============================================================
# FABRIC GATEWAY CONNECTION
# These paths are relative to the project root and are
# populated after the network starts and identities are enrolled.
# The backend reads these to connect to the Fabric network.
# ============================================================
FABRIC_CHANNEL=tessera-channel
FABRIC_CHAINCODE=asset
FABRIC_CHAINCODE_LABEL=asset_1.0

# Identity used by the backend to connect to Fabric
FABRIC_MSP_ID=IssuerMSP

# Peer TLS certificate (CA cert for peer TLS)
FABRIC_PEER_TLS_CERT=blockchain/organizations/peerOrganizations/issuer.tessera.com/peers/peer0.issuer.tessera.com/tls/ca.crt

# Backend identity credentials
FABRIC_IDENTITY_CERT=blockchain/organizations/peerOrganizations/issuer.tessera.com/users/Admin@issuer.tessera.com/msp/signcerts/cert.pem
FABRIC_IDENTITY_KEY_DIR=blockchain/organizations/peerOrganizations/issuer.tessera.com/users/Admin@issuer.tessera.com/msp/keystore

# Peer gRPC endpoint
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOSTNAME=peer0.issuer.tessera.com
