# TESSERA frontend environment configuration.
# Copy to .env for local development. Never commit .env (see .gitignore).
# No secrets belong in frontend environment files.

# Base URL of the TESSERA Express API (no trailing slash).
VITE_API_BASE_URL=http://localhost:3000/api

# Backend health endpoint base (used for connectivity status).
VITE_HEALTH_BASE_URL=http://localhost:3000

# Request timeout in milliseconds for API calls.
VITE_API_TIMEOUT_MS=15000
