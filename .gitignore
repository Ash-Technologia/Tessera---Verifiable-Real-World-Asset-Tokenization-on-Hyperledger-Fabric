# =============================================================================
# TESSERA .gitignore
# =============================================================================

# --- Fabric Generated Crypto Material (NEVER commit private keys or certs) ---
blockchain/organizations/fabric-ca/
blockchain/organizations/ordererOrganizations/
blockchain/organizations/peerOrganizations/

# --- Fabric Generated Channel Artifacts ---
blockchain/network/channel-artifacts/
blockchain/network/system-genesis-block/

# --- Chaincode Build Artifacts ---
blockchain/chaincode/asset/vendor/
blockchain/chaincode/**/*.test

# --- Node.js ---
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# --- Environment Secrets ---
.env
backend/.env

# --- Log Files ---
*.log
logs/
blockchain/scripts/*.log

# --- Go Build Artifacts ---
*.exe
*.test
dist/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Docker ---
# docker-compose.yml and docker-compose.override.yml are committed
# Per-run state is in named Docker volumes (managed by Docker)

# --- Temporary & Local Storage ---
tmp/
temp/
scratch/
data/

